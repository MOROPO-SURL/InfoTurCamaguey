<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
		<AssemblyName>MOROPO.InfoTur.Camaguey.Rutas</AssemblyName>
		<RootNamespace>MOROPO.InfoTur.Camaguey.Rutas</RootNamespace>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\DBs\map.mbtiles" />
		<None Remove="Resources\Fonts\materialdesignicons-webfont.ttf" />
		<None Remove="Resources\Vectors\footer.svg" />
		<None Remove="Resources\Vectors\header.svg" />
		<None Remove="Resources\Vectors\logo.svg" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\DBs\map.mbtiles" />
		<EmbeddedResource Include="Resources\Fonts\materialdesignicons-webfont.ttf" />
		<EmbeddedResource Include="Resources\Vectors\footer.svg" />
		<EmbeddedResource Include="Resources\Vectors\logo.svg" />
		<EmbeddedResource Include="Resources\Vectors\header.svg" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AltroEasyAR" Version="4.6.4" />
		<PackageReference Include="BruTile.MbTiles" Version="5.0.6" />
		<PackageReference Include="Mapsui.Forms" Version="4.1.9" />
		<PackageReference Include="SSCXFToolKit.Mvvm" Version="0.4.10-alpha" />
		<PackageReference Include="SSCXFToolKit.Presentation" Version="0.6.4" />
		<PackageReference Include="UrhoSharp.Forms" Version="1.9.67" />
		<PackageReference Include="Xamarin.FFImageLoading.Svg.Forms" Version="2.4.11.982" />
		<PackageReference Include="Xamarin.Forms" Version="5.0.0.2662" />
		<PackageReference Include="Xamarin.Essentials" Version="1.8.1" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Converters\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="AppResources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\AboutPage.xaml">
			<Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\CatalogPage.xaml">
			<Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\ConfigurationPage.xaml">
			<Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\GuideARPage.xaml">
		  <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\MainPage.xaml">
			<Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\MapPage.xaml">
			<Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Pages\VirtualTour1Page.xaml">
		  <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
		<EmbeddedResource Update="UI\Views\BusyView.xaml">
		  <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
		</EmbeddedResource>
	</ItemGroup>
</Project>