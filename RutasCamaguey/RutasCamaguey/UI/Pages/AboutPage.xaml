<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:root="clr-namespace:MOROPO.InfoTur.Camaguey.Rutas"
    x:Class="MOROPO.InfoTur.Camaguey.Rutas.UI.Pages.AboutPage"
    Title="{Static root:AppResources.CommonAbout}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="16" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView Orientation="Vertical">
            <StackLayout Padding="16" Spacing="16">
                <Label Text="{Static root:AppResources.AboutIntro}" />
                <Label Text="{Static root:AppResources.AboutFeaturesCaption}" />
                <StackLayout Orientation="Horizontal">
                    <Label Text="-" />
                    <Label Text="{Static root:AppResources.AboutFeature1}" />
                </StackLayout>
                <StackLayout Orientation="Horizontal">
                    <Label Text="-" />
                    <Label Text="{Static root:AppResources.AboutFeature2}" />
                </StackLayout>
                <StackLayout Orientation="Horizontal">
                    <Label Text="-" />
                    <Label Text="{Static root:AppResources.AboutFeature3}" />
                </StackLayout>
                <Label Text="{Static root:AppResources.AboutDescriptionParagraph1}" />
                <StackLayout Orientation="Vertical" Spacing="8">
                    <Label 
                        Text="{Static root:AppResources.AboutTitularCaption}" 
                        FontAttributes="Bold" />
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutTitularName}" />
                    </StackLayout>
                </StackLayout>
                <StackLayout Orientation="Vertical" Spacing="8">
                    <Label 
                        Text="{Static root:AppResources.AboutAuthorCaption}" 
                        FontAttributes="Bold" />
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutAuthorName}" />
                    </StackLayout>
                </StackLayout>
                <StackLayout Orientation="Vertical" Spacing="8">
                    <Label 
                        Text="{Static root:AppResources.AboutCollaborationCaption}" 
                        FontAttributes="Bold" />
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutCollaborator1}" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutCollaborator2}" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutCollaborator3}" />
                    </StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="-" />
                        <Label Text="{Static root:AppResources.AboutCollaborator4}" />
                    </StackLayout>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>